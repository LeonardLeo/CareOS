node_modules/
# Build output. Anchored to this app rather than added to the root .gitignore as a bare
# `dist/`, which is the pattern that previously swallowed apps/admin-web/src/lib.
/dist/
*.tsbuildinfo
.env.local

# Playwright artifacts. The screenshots are regenerated by `npx playwright test screens.spec.ts`
# and uploaded by CI, so they are not source.
/screenshots/
/test-results/
/playwright-report/
