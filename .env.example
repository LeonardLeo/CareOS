# Published host ports for docker-compose.yml. Copy to `.env` (gitignored) on a machine
# that already binds one of the defaults — otherwise leave this file unused and compose
# keeps the documented ports.
#
# Container-to-container addresses never change: Postgres inside the network is always
# `postgres:5432`, Redis is always `redis:6379`. Only the *host* publish mapping moves.
#
# On Windows a silent collision is the failure mode to watch for: Docker keeps the IPv6
# bind, the native service keeps IPv4, and `localhost` reaches whichever the resolver
# prefers. The symptom is a password rejection (or a 500 on `/v1/platform/auth/login` if
# only the platform URL still points at the wrong Postgres), not an obvious "port in use".
#
# When you remap CAREOS_POSTGRES_PORT, every URL in `services/api/.env` must use the same
# host port — including CAREOS_PLATFORM_DATABASE_URL. Leaving that one on 5432 while the
# others use the remap is how platform sign-in fails after agency sign-in works.

CAREOS_POSTGRES_PORT=5432
CAREOS_REDIS_PORT=6379
CAREOS_API_PORT=8000
CAREOS_PROMETHEUS_PORT=9090
CAREOS_ALERTMANAGER_PORT=9093
CAREOS_ALERT_SINK_PORT=9099
