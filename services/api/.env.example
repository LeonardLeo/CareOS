# Copy to .env for local development. NEVER commit a real .env.
#
# In staging and production every value below comes from the secrets manager
# (`docs/08_Security_Architecture.md` Section 5), injected at deploy time.

CAREOS_ENVIRONMENT=local

# Application role — no BYPASSRLS, so Row-Level Security binds it.
# If Docker Postgres is published on a non-default host port (repo-root `.env` /
# `.env.example`, CAREOS_POSTGRES_PORT), change the port in *all four* URLs below —
# including the platform one. A lone CAREOS_PLATFORM_DATABASE_URL left on 5432 is a
# 500 on `/v1/platform/auth/login`, not a connection-refused error.
CAREOS_DATABASE_URL=postgresql+asyncpg://careos_app:careos_app@localhost:5432/careos
# Narrow BYPASSRLS role: login lookups and agency provisioning only.
CAREOS_PRIVILEGED_DATABASE_URL=postgresql+asyncpg://careos_auth:careos_auth@localhost:5432/careos
# CareOS operator console. Holds no BYPASSRLS; see migration 0013_platform_operations.
CAREOS_PLATFORM_DATABASE_URL=postgresql+asyncpg://careos_platform:careos_platform@localhost:5432/careos
# Owner/DDL connection, used by migrations only.
CAREOS_MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/careos

CAREOS_REDIS_URL=redis://localhost:6379/0

# Local-only placeholder. get_settings() refuses to start in production with this value.
CAREOS_JWT_SECRET=dev-only-insecure-secret-change-me

# Base64-encoded 32 bytes, for AES-256-GCM field encryption. Required outside local/test.
# Generate with:
#   python -c "from careos.core.crypto import generate_key_b64; print(generate_key_b64())"
# CAREOS_FIELD_ENCRYPTION_KEY=

# Transmit EVV to vendor sandboxes rather than production aggregators. Staging must never
# be pointed at production endpoints (`docs/03_Technical_Architecture.md` Section 7).
CAREOS_EVV_USE_SANDBOX=true
